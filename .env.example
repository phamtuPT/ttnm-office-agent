# Sao chép thành backend/.env (chạy tay) hoặc .env ở thư mục gốc (docker compose).
# Nhà cung cấp, model và khoá API cũng đổi được ngay trên giao diện (nút ⚙) mà không cần khởi động lại;
# giá trị ở đây chỉ là mặc định ban đầu.

# gemini | openai | ollama | mock ("mock" = trợ lý giả để thử giao diện, không tốn tiền)
LLM_PROVIDER=mock

GEMINI_API_KEY=
AGENT_MODEL=gemini-3.8-flash
LITE_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-flash-lite

OPENAI_API_KEY=
OPENAI_MODEL=

# Docker với --profile ollama: http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Che email, số điện thoại, số thẻ, URL trước khi gửi lên đám mây
PII_MASKING=false

MAX_STEPS=10
TOOL_TIMEOUT_S=60
TURN_TIMEOUT_S=300
STREAM_IDLE_TIMEOUT_S=60
MAX_GENERATIONS=20
MAX_UPLOAD_MB=20

# Đường dẫn soffice nếu không có trong PATH (Windows: C:\Program Files\LibreOffice\program\soffice.exe)
SOFFICE_PATH=
