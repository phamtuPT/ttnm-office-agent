# Sao chép thành backend/.env (chạy tay) hoặc .env ở thư mục gốc (docker compose) rồi điền khoá.

# "gemini" để gọi Gemini thật, "mock" để làm giao diện/test không tốn tiền
LLM_PROVIDER=mock
GEMINI_API_KEY=

# Model — xem docs/LLM_GEMINI.md. Giá gemini-3.8-flash tăng gấp đôi từ 01/01/2027.
AGENT_MODEL=gemini-3.8-flash
LITE_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-flash-lite

MAX_STEPS=8
TOOL_TIMEOUT_S=30
TURN_TIMEOUT_S=180
MAX_UPLOAD_MB=20
