# Sao chép thành backend/.env (chạy tay) hoặc .env ở thư mục gốc (docker compose).
# Nhà cung cấp, model và khoá API cũng đổi được ngay trên giao diện (nút ⚙) mà không cần khởi động lại;
# giá trị ở đây chỉ là mặc định ban đầu.

# gemini | openai | ollama | mock ("mock" = trợ lý giả để thử giao diện, không tốn tiền)
LLM_PROVIDER=mock

GEMINI_API_KEY=
AGENT_MODEL=gemini-3.8-flash
LITE_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-flash-lite
# Mức suy nghĩ của model agent: low (nhanh, mặc định) | medium | high; trống = mặc định của model
AGENT_THINKING_LEVEL=low

OPENAI_API_KEY=
OPENAI_MODEL=

# Docker với --profile ollama: http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=

# Cơ sở dữ liệu PostgreSQL. Docker compose tự đặt DATABASE_URL cho backend từ POSTGRES_PASSWORD.
# Chạy backend bằng tay thì cần một PostgreSQL trên máy:
#   docker compose up -d db          → DATABASE_URL=postgresql://office:<POSTGRES_PASSWORD>@localhost:5432/office_agent
#   python scripts/dev_postgres.py   → DATABASE_URL=postgresql://office@localhost:5432/office_agent (không cần Docker)
# Để trống DATABASE_URL = SQLite storage/app.db (chỉ để thử nhanh). Mật khẩu chỉ nên gồm chữ và số.
DATABASE_URL=postgresql://office@localhost:5432/office_agent
POSTGRES_PASSWORD=

# Che email, số điện thoại, số thẻ, URL trước khi gửi lên đám mây
PII_MASKING=false

MAX_STEPS=10
TOOL_TIMEOUT_S=60
TURN_TIMEOUT_S=300
STREAM_IDLE_TIMEOUT_S=60
MAX_GENERATIONS=20
MAX_UPLOAD_MB=20

# Đường dẫn soffice nếu không có trong PATH (Windows: C:\Program Files\LibreOffice\program\soffice.exe)
SOFFICE_PATH=
# OCR cục bộ (Tesseract) để đối chứng với vision LLM; trống = tìm trong PATH
TESSERACT_PATH=
# Sandbox chạy run_python. Docker compose tự đặt http://sandbox:9000; trống = tắt tính năng
SANDBOX_URL=
